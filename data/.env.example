# Copy this file to .env (never commit .env — it's gitignored) and fill in
# real values. ADMIN_SECRET in particular should be a long random string,
# known only to you — it gates the dev-user management screen.

PORT=4000
ADMIN_SECRET=change-me-to-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
NODE_ENV=development
# Set to "true" only once client/ and data/ are hosted on different domains
# (e.g. GitHub Pages + a separate API host) — required for session cookies
# to survive a real cross-origin deployment. Leave "false"/unset for local
# dev, where the Vite proxy already makes them same-origin.
COOKIE_CROSS_SITE=false

# Optional — set these on a hosted deploy (e.g. Render's free tier, which
# wipes the local filesystem on every idle spin-down/redeploy) so the
# dev-user roster and QA annotations survive by committing straight to
# this repo instead of relying on the host's disk. Leave both unset for
# local dev — everything still works, just local-disk-only, exactly as
# before this existed. See data/lib/githubPersist.js.
#
# GITHUB_TOKEN needs a fine-grained Personal Access Token, scoped to ONLY
# this repository, with Contents: Read and write permission — nothing
# broader. Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_REPO=invierno8/commando
GITHUB_BRANCH=main
